<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/terminalBg"
    android:fitsSystemWindows="true">

    <!-- Top bar: history + address + reload/stop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/browser_back_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_back"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            android:tint="?attr/terminalText" />

        <ImageButton
            android:id="@+id/browser_forward_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_forward"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_forward"
            android:tint="?attr/terminalText"
            android:alpha="0.4" />

        <EditText
            android:id="@+id/browser_url"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_url_field"
            android:hint="@string/browser_url_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="?attr/terminalText"
            android:textColorHint="#66CDD6F4"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/browser_reload_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_reload"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_reload"
            android:tint="?attr/terminalText" />
    </LinearLayout>

    <!-- Page load progress -->
    <ProgressBar
        android:id="@+id/browser_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressTint="?attr/colorPrimary"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/browser_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Old bottom toolbar (zoom/find/share/home) collapsed into one
             overflow button, per user request: the page gets all the space. -->
        <TextView
            android:id="@+id/browser_menu_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_keyboard_chip"
            android:contentDescription="@string/browser_menu"
            android:elevation="6dp"
            android:gravity="center"
            android:text="@string/browser_overflow"
            android:textColor="?attr/terminalText"
            android:textSize="22sp" />
    </FrameLayout>

    <!-- Find in page -->
    <LinearLayout
        android:id="@+id/browser_find_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/extraKeysBg"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/browser_find_input"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/browser_find_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="?attr/terminalText"
            android:textColorHint="#66CDD6F4"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/browser_find_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="@string/browser_find_none"
            android:textColor="?attr/terminalText"
            android:textSize="12sp"
            android:alpha="0.6" />

        <TextView
            android:id="@+id/browser_find_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/browser_back"
            android:gravity="center"
            android:text="@string/key_up"
            android:textColor="?attr/terminalText"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/browser_find_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/browser_forward"
            android:gravity="center"
            android:text="@string/key_down"
            android:textColor="?attr/terminalText"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/browser_find_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/key_close"
            android:gravity="center"
            android:text="@string/key_close"
            android:textColor="?attr/terminalText"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>

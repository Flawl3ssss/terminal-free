<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/terminalBg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/files_back_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back_chip"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/files_title"
            android:textColor="?attr/terminalText"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/files_pick_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/files_pick_hint"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:background="?attr/extraKeysBg"
        android:visibility="gone" />

    <TextView
        android:id="@+id/files_path"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:paddingHorizontal="14dp"
        android:gravity="center_vertical"
        android:textColor="?attr/terminalText"
        android:textSize="12sp"
        android:alpha="0.6"
        android:background="?attr/extraKeysBg"
        android:singleLine="true"
        android:ellipsize="start" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/files_tab_workspace"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/files_workspace"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/files_tab_device"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/files_device"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/files_btn_up"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:text="@string/files_up"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/terminalBg"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/files_btn_new_folder"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:text="@string/files_new_folder"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/terminalBg"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/files_btn_import"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:text="@string/files_import"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/terminalBg"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/files_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:text="@string/files_refresh"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/terminalBg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/files_btn_sort"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/terminalBg"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/files_btn_sort_dir"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:text="↓"
            android:textColor="?attr/colorPrimary"
            android:textSize="15sp"
            android:background="?attr/terminalBg"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/files_btn_search"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:text="@string/files_search"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:background="?attr/terminalBg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/files_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#3A3A4C"
            android:dividerHeight="1dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/files_empty_msg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="?attr/terminalText"
            android:textSize="14sp"
            android:alpha="0.6"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

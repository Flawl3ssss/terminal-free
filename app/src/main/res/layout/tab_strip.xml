<?xml version="1.0" encoding="utf-8"?>
<!--
    Slim screen tabs shared by Terminal / Browser / Files.
    Docked (not an overlay):42 dp tall, three equal cells, vector icons
    tinted per-screen by ScreenTabs.attach (active = colorPrimary).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:orientation="horizontal"
    android:background="?attr/extraKeysBg"
    android:gravity="center_vertical">

    <ImageButton
        android:id="@+id/tab_terminal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:src="@drawable/ic_tab_terminal"
        android:scaleType="centerInside"
        android:padding="9dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/tab_terminal" />

    <ImageButton
        android:id="@+id/tab_browser"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:src="@drawable/ic_tab_browser"
        android:scaleType="centerInside"
        android:padding="9dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/tab_browser" />

    <ImageButton
        android:id="@+id/tab_files"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:src="@drawable/ic_tab_files"
        android:scaleType="centerInside"
        android:padding="9dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/tab_files" />
</LinearLayout>

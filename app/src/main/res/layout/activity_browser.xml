<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/terminalBg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/browser_back_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back_chip"
            android:scaleType="centerInside"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <EditText
            android:id="@+id/browser_url"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:hint="@string/browser_url_hint"
            android:textColor="?attr/terminalText"
            android:textColorHint="?attr/terminalText"
            android:textSize="14sp"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:background="@android:drawable/edit_text" />

        <TextView
            android:id="@+id/browser_go"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:text="@string/browser_go"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:background="?attr/terminalBg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/browser_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:background="?attr/extraKeysBg">

        <TextView
            android:id="@+id/browser_zoom_out"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/browser_zoom_out"
            android:textColor="?attr/colorPrimary"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/browser_zoom_in"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/browser_zoom_in"
            android:textColor="?attr/colorPrimary"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/browser_reload"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/browser_reload"
            android:textColor="?attr/colorPrimary"
            android:textSize="20sp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
